def file_urls(fn):
    return ('https://commons.wikimedia.org/wiki/Special:FilePath/'+quote(fn,safe='')+'?width=1800','https://commons.wikimedia.org/wiki/File:'+quote(fn.replace(' ','_'),safe='_:,()'))
def exact_tokens(it):
    a=[x for x in toks(it.name) if x not in ('scene','prime','center','grand','sunshine','legacy','little','gem','golden','rose','madame','madam','nook','field','loading')]
    return a or toks(it.name)
def fetch(it):
    path=IMG/f"{norm(it.section)[:3]}_{it.number:02d}_{fname(it.name)}.jpg"
    if it.name in FILES:
        u,p=file_urls(FILES[it.name])
